FROM ubuntu:22.04

# Install Python
RUN apt-get -y update && \
    apt-get install -y python3-pip curl

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin/:$PATH"

#Set environnement
COPY pyproject.toml .
COPY uv.lock .             
RUN uv sync --frozen 

#Export external data (temporary, later : put on Onyxia)
COPY data_external\revenu_median_communes.csv .

COPY Config.py .
COPY src/ ./src/ 

#run data preparation script  (based on uv) 
CMD ["uv", "run", "python", "src/data_processing/prepare_data.py"]