FROM python:3.13-slim  

RUN apt-get update && apt-get install -y curl --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin/:$PATH"

COPY pyproject.data_prep.toml pyproject.toml
COPY uv.data_prep.lock uv.lock
RUN uv sync --frozen 

COPY data_external/ ./data_external/ 
COPY Config.py .
COPY src/ ./src/ 

CMD ["uv", "run", "python", "src/data_processing/prepare_data.py"]