#Dockerfile for data preparation with encoding
FROM python:3.13-slim  

# Install Python
RUN apt-get -y update && \
    apt-get install -y python3-pip curl

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin/:$PATH"

#Set environnement
COPY pyproject.data_prep.toml .
COPY uv.lock .             
RUN uv sync --frozen 

#Export external data (temporary, later : put on Onyxia)
COPY data_external/ ./data_external/ 

COPY Config.py .
COPY src/ ./src/ 

#run data preparation script  (based on uv) 
CMD ["uv", "run", "python", "src/data_processing/prepare_data.py"]