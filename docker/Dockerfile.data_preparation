FROM python:3.13-slim  

RUN apt-get update && apt-get install -y curl --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin/:$PATH"

COPY pyproject.toml .
COPY uv.lock .
RUN uv sync --frozen 

COPY data_external/ ./data_external/ 
COPY Config.py .
COPY src/ ./src/ 

CMD ["sh", "-c", "uv run python src/data_processing/prepare_data_noenc_nonorm.py && \
                  uv run python src/data_processing/prepare_data_enc_norm.py && \
                  uv run python src/data_processing/prepare_data_enc_nonorm.py"] 